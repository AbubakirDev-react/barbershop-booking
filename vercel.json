{
  "rewrites": [
    {
      "source": "/sb/:path*",
      "destination": "https://ihpqnoobjlcpozusxomd.supabase.co/:path*"
    },
    {
      "source": "/((?!assets/|sb/|favicon.svg|robots.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "export VITE_SUPABASE_URL=/sb; npx tsc -b && npx vite build",
  "outputDirectory": "dist"
}
